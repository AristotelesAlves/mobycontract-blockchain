# cp .env.example .env
# O projeto NAO carrega .env: use `set -a; . ./.env; set +a` ou `docker compose`.
# Comentarios sem acento: este arquivo e editado em terminais cp1252.

# --- local: anvil (npm run node) -------------------------------------------
CHAIN_ID_ESPERADO=31337
RPC_URL=http://127.0.0.1:8545
NOME_CHAIN=anvil-local
CHAVE_PRIVADA=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CHAVE_API=chave-local-de-desenvolvimento
PSEUDONIMO_SALT=salt-local-de-desenvolvimento-nao-usar-em-producao
LOG_LEVEL=info
PORT=4000

# --- assinatura por parte (Web3Signer), opcional ---------------------------
# Sem WEB3SIGNER_URL o servico assina toda escrita com CHAVE_PRIVADA. Com ela,
# uma chave de API que tenha `endereco` faz a transacao sair assinada por esse
# endereco no Web3Signer (msg.sender on-chain = a parte), e nao pela carteira do
# servico. Suba o servico com o compose da rede e onboarde a parte com:
#   npm run participante -- <nome>
# WEB3SIGNER_URL=http://127.0.0.1:9000/

# --- administracao de participantes pela API (POST/DELETE /participantes) ---
# Habilita o onboarding/offboarding sem shell. Sem ENDERECO_PARTICIPANTES (nem
# deployments/<chain>.json) as rotas nem sao montadas. Cada capacidade e opcional:
# sem RPC_ADMIN_URLS pula a allowlist Besu; sem WEB3SIGNER_KEYSTORE_DIR exige
# `endereco`/`chavePrivada` no corpo e nao publica chave.
# ENDERECO_PARTICIPANTES=0x<RegistroDeParticipantes>
# RPC_ADMIN_URLS=http://127.0.0.1:8545,http://127.0.0.1:8546,http://127.0.0.1:8547,http://127.0.0.1:8548
# WEB3SIGNER_KEYSTORE_DIR=besu/web3signer
# PERMISSIONAMENTO_ARQUIVO=besu/rede/permissions_config.toml

# Sem JWT_SECRETO (min 32 caracteres) e ADMIN_SENHA/ADMIN_SENHA_HASH o servico
# nao sobe. ADMIN_SENHA_HASH tem prioridade e evita senha em texto plano.
ADMIN_USUARIO=admin
ADMIN_SENHA=admin-local-de-desenvolvimento
# ADMIN_SENHA_HASH=scrypt$<sal-hex>$<hash-hex>
JWT_SECRETO=segredo-jwt-local-de-desenvolvimento-nao-usar-em-producao
JWT_EXPIRACAO_SEGUNDOS=3600
CAMINHO_BANCO=data/mobycontract.db
# Opcional no Docker (o entrypoint resolve de deployments/31337.json),
# obrigatoria em `npm run registry`.
ENDERECO_CONTRATO=0x5FbDB2315678afecb367f032d93F642d64180aa3

# CHAVE_API vazia NAO desliga a autenticacao: as rotas protegidas passam a exigir
# uma API key gerenciada (emitida por /api-keys) e respondem 401 sem ela.
# Uma API key pode receber um "endereco" de parte e entao le so os proprios
# contratos (GET /meus-contratos).
# PSEUDONIMO_SALT e lido na subida: sem ele o servico nao sobe.

# --- Besu QBFT (consorcio permissionado) ------------------------------------
# 1. sh besu/gerar-rede.sh   2. docker compose -f besu/docker-compose.yml up -d
# 3. npm run deploy:besu
# BESU_CHAIN_ID=20250101
# BESU_RPC_URL=http://127.0.0.1:8545
# BESU_PRIVATE_KEY=0x<chave de validador de besu/rede>
# CHAIN_ID_ESPERADO=20250101
# RPC_URL=http://127.0.0.1:8545
# NOME_CHAIN=besu-consorcio
# WIRAR_CONTROLADOR=true

# --- Polygon Amoy (testnet) -------------------------------------------------
# CHAIN_ID_ESPERADO=80002
# RPC_URL=https://rpc-amoy.polygon.technology
# NOME_CHAIN=polygon-amoy
# AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# CHAVE_PRIVADA=0x<CARTEIRA_DE_OPERACAO_COM_MATIC>
# CHAVE_API=<segredo>
# PSEUDONIMO_SALT=<openssl rand -hex 32>
# ADMIN_SENHA_HASH=<gerado por scripts/gerar-senha.ts>
# JWT_SECRETO=<openssl rand -hex 32>
# DEPLOYER_PRIVATE_KEY=0x<CARTEIRA_DE_IMPLANTACAO>
# ENDERECO_CONTRATO=0x<endereco de deployments/80002.json>

# --- so no container --------------------------------------------------------
# CAMINHO_ABI=/app/abi/MobyContractRegistry.json
# DEPLOYMENTS_DIR=/app/deployments
