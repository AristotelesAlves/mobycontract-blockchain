name: local_environment
variables:
  - name: base_url
    value: 'http://localhost:4000'
    description: Registry service local da camada blockchain
  - name: token
    value: ''
    description: Token JWT do administrador - salvo automaticamente pelo Login
  - name: apiKey
    value: 'chave-local-de-desenvolvimento'
    description: Chave de API das rotas de ancoragem e consulta (estatica do ambiente ou emitida pelo Criar Chave API)
  - name: id
    value: '1'
    description: ID generico (api-key do revogar-chave / participante do remover)
  - name: contratoId
    value: 'CT-2026-001'
    description: Identificador do contrato no ledger
  - name: aditivoId
    value: 'ADT-001'
    description: Identificador do aditivo
  - name: vistoriaId
    value: 'VST-001'
    description: Identificador da vistoria
  - name: imovelId
    value: 'IMO-001'
    description: Identificador do imovel
  - name: parte
    value: '0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266'
    description: Endereco 0x da parte do contrato (conta padrao do Anvil, checksum EIP-55)
